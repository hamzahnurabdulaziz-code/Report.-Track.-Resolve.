# BantuWarga - Platform Layanan dan Informasi Masyarakat
# Konfigurasi Supabase (Dapatkan dari Project Settings > API di Dashboard Supabase)

# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Aman digunakan di browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (Hanya untuk server side / migration, JANGAN diekspos ke browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL Aplikasi (untuk redirect auth callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000
